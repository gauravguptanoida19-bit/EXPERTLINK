# ==============================================================================
# ExpertLink Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:4200

# Relational Database (PostgreSQL 16)
DATABASE_URL=postgresql://expertlink:expertlink_secret@localhost:5432/expertlink_db?schema=public
POSTGRES_USER=expertlink
POSTGRES_PASSWORD=expertlink_secret
POSTGRES_DB=expertlink_db
POSTGRES_PORT=5432

# NoSQL Database (MongoDB 7)
MONGODB_URI=mongodb://localhost:27017/expertlink_mongo
MONGO_INITDB_DATABASE=expertlink_mongo
MONGO_PORT=27017

# Cache & Queues (Redis 7)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long-expertlink-token
JWT_REFRESH_SECRET=super-secret-refresh-key-minimum-32-chars-long-expertlink-token
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Machine Learning Service (FastAPI)
ML_SERVICE_URL=http://localhost:8000
ML_PORT=8000
ML_MODEL_NAME=all-MiniLM-L6-v2
RANKER_WEIGHT_SEMANTIC=0.40
RANKER_WEIGHT_SKILLS=0.25
RANKER_WEIGHT_INDUSTRY=0.15
RANKER_WEIGHT_EXPERIENCE=0.10
RANKER_WEIGHT_LR_MODEL=0.10

# LLM Query Assistant (Optional with deterministic fallback)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Observability
LOG_LEVEL=info
PROMETHEUS_METRICS_PATH=/metrics
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Web Client
WEB_PORT=4200
